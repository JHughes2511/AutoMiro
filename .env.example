# ─── The Movement — Model Barrels ──────────────────────────────────────────
# Claude API key (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model assignments (defaults shown — change to adjust cost/quality tradeoff)
MODEL_FAST=claude-haiku-4-5-20251001
MODEL_MID=claude-sonnet-4-6
MODEL_HEAVY=claude-opus-4-7

# ─── Memory Layer ───────────────────────────────────────────────────────────
# Zep Cloud free tier: https://app.getzep.com/
# Optional — system works without it, but memory won't persist across sessions
ZEP_API_KEY=your_zep_api_key_here

# ─── Agent Runtime ──────────────────────────────────────────────────────────
MAX_CONCURRENT_AGENTS=8
AGENT_ITERATION_LIMIT=5
RESEARCH_TIMEOUT_SECONDS=300

# ─── App ────────────────────────────────────────────────────────────────────
DEBUG=false
SECRET_KEY=change-this-in-production
DATA_DIR=./data
